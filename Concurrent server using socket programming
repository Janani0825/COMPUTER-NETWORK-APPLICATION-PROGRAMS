#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <arpa/inet.h>
#include <sys/socket.h>

int main()
{
    int s, n, choice;
    char op, buffer[1024], status, filename[256];
    struct sockaddr_in server;
    FILE *fp;

    s = socket(AF_INET, SOCK_STREAM, 0);

    server.sin_family = AF_INET;
    server.sin_port = htons(4800);
    server.sin_addr.s_addr = inet_addr("127.0.0.1");

    if (connect(s, (struct sockaddr *)&server, sizeof(server)) < 0)
    {
        perror("Connection failed");
        close(s);
        return 1;
    }

    printf("1. Store file\n");
    printf("2. Retrieve file\n");
    printf("Enter choice: ");
    scanf("%d", &choice);
    getchar(); // Clear the newline character from the buffer

    if (choice == 1)
    {
        op = '1';
        printf("Enter the local filename to send: ");
        scanf("%255s", filename);

        fp = fopen(filename, "rb");
        if (fp == NULL)
        {
            printf("Source file not found.\n");
            close(s);
            return 1;
        }

        // 1. Send operation code
        send(s, &op, 1, 0);

        // 2. Send filename meta (length + content)
        int name_len = strlen(filename);
        send(s, &name_len, sizeof(name_len), 0);
        send(s, filename, name_len, 0);

        // 3. Send file payload
        while ((n = fread(buffer, 1, sizeof(buffer), fp)) > 0)
            send(s, buffer, n, 0);

        fclose(fp);
        shutdown(s, SHUT_WR); // Tell server file writing is finished

        printf("File sent to server for storage.\n");
    }
    else if (choice == 2)
    {
        op = '2';
        printf("Enter the filename to retrieve from server: ");
        scanf("%255s", filename);

        // 1. Send operation code
        send(s, &op, 1, 0);

        // 2. Send filename meta (length + content)
        int name_len = strlen(filename);
        send(s, &name_len, sizeof(name_len), 0);
        send(s, filename, name_len, 0);

        // 3. Read status byte from server
        if (recv(s, &status, 1, MSG_WAITALL) <= 0 || status == '0')
        {
            printf("File not found on server.\n");
            close(s);
            return 0;
        }

        // Ask user what they want to name the downloaded file locally
        char out_filename[256];
        printf("Enter local name to save as: ");
        scanf("%255s", out_filename);

        fp = fopen(out_filename, "wb");
        if (fp == NULL)
        {
            perror("Cannot create output file");
            close(s);
            return 1;
        }

        // 4. Download file data
        while ((n = recv(s, buffer, sizeof(buffer), 0)) > 0)
            fwrite(buffer, 1, n, fp);

        fclose(fp);
        printf("File downloaded successfully as '%s'.\n", out_filename);
    }
    else
    {
        printf("Invalid choice.\n");
    }

    close(s);
    return 0;
}

