#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <string.h>
#include <arpa/inet.h>
#include <sys/socket.h>
#include <sys/types.h>
#include <sys/wait.h>

int main()
{
    int s, c, n;
    char op, buffer[1024], filename[256];
    struct sockaddr_in server, client;
    socklen_t len = sizeof(client);
    FILE *fp;

    s = socket(AF_INET, SOCK_STREAM, 0);

    server.sin_family = AF_INET;
    server.sin_port = htons(4800);
    server.sin_addr.s_addr = INADDR_ANY;

    // Reuse address to avoid "Address already in use" errors
    int opt = 1;
    setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));

    if (bind(s, (struct sockaddr *)&server, sizeof(server)) < 0) {
        perror("Bind failed");
        return 1;
    }
    listen(s, 5);

    printf("Server waiting for clients...\n");

    while (1)
    {
        c = accept(s, (struct sockaddr *)&client, &len);

        if (c < 0)
            continue;

        if (fork() == 0)
        {
            close(s);

            // 1. Receive Operation Code
            if (recv(c, &op, 1, 0) <= 0)
            {
                close(c);
                exit(1);
            }

            // 2. Receive Filename length first, then the string
            int name_len = 0;
            if (recv(c, &name_len, sizeof(name_len), 0) <= 0) {
                close(c);
                exit(1);
            }
            if (recv(c, filename, name_len, 0) <= 0) {
                close(c);
                exit(1);
            }
            filename[name_len] = '\0'; // Null-terminate string

            if (op == '1')
            {
                /* STORE: receive file content */
                fp = fopen(filename, "wb");
                if (fp == NULL)
                {
                    perror("File open error on server");
                    close(c);
                    exit(1);
                }

                while ((n = recv(c, buffer, sizeof(buffer), 0)) > 0)
                    fwrite(buffer, 1, n, fp);

                fclose(fp);
                printf("File '%s' stored successfully.\n", filename);
            }
            else if (op == '2')
            {
                /* RETRIEVE: send file content to client */
                fp = fopen(filename, "rb");

                if (fp == NULL)
                {
                    send(c, "0", 1, 0); // File not found status
                }
                else
                {
                    send(c, "1", 1, 0); // File exists status

                    while ((n = fread(buffer, 1, sizeof(buffer), fp)) > 0)
                        send(c, buffer, n, 0);

                    fclose(fp);
                    printf("File '%s' retrieved successfully.\n", filename);
                }
            }

            close(c);
            exit(0);
        }

        close(c);
        waitpid(-1, NULL, WNOHANG);
    }

    close(s);
    return 0;
}
