#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#define MAX_BITS    10000
#define MAX_FRAMES  100
#define FILENAME    "bitframe.dat"
#define FLAG    "01111110"
#define ADDRESS "11111111"
#define CONTROL "00000000"
#define FCS     "00000000000000000000000000000000"
#define FLAG_LEN    8
#define ADDR_LEN    8
#define CTRL_LEN    8
#define FCS_LEN     32
typedef struct
{
    char flag1[9];
    char address[9];
    char control[9];
    char information[1000];
    char fcs[33];
    char flag2[9];
} PPP_Frame;
void bitStuffing(char *data, int totalBits, int numFrames);
void bitDestuffing(void);
void displayFrames(void);
int  parseFrame(char *line, PPP_Frame *frame);
void stuffData(char *input, char *output);
int  destuffData(char *input, char *output);

#include "bithead.h"
void stuffData(char *input, char *output)
{
    int i, j = 0, count = 0;
    int len = strlen(input);
    int prevZero = 0;
    int eligible = 0;

    for (i = 0; i < len; i++)
    {
        char c = input[i];

        if (c == '1')
        {
            if (count == 0)
            {
                eligible = prevZero;
            }
            output[j++] = c;
            count++;

            if (count == 5 && eligible)
            {
                output[j++] = '0';
                count = 0;
                eligible = 0;
            }
            prevZero = 0;
        }
        else /* c == '0' */
        {
            output[j++] = c;
            count = 0;
            eligible = 0;
            prevZero = 1;
        }
    }
    output[j] = '\0';
}

int destuffData(char *input, char *output)
{
    int i, j = 0, count = 0;
    int len = strlen(input);
    int prevZero = 0;
    int eligible = 0;

    for (i = 0; i < len; i++)
    {
        char c = input[i];

        if (c == '1')
        {
            if (count == 0)
            {
                eligible = prevZero;
            }
            output[j++] = c;
            count++;

            if (count == 5 && eligible)
            {
                if (i + 1 < len && input[i + 1] == '0')
                {
                    i++;
                    count = 0;
                    eligible = 0;
                    prevZero = 0;
                    continue;
                }
                else if (i + 2 < len && input[i + 1] == '1' && input[i + 2] == '0')
                {
                    printf("Warning: Flag pattern (01111110) detected inside the field.\n");
                    output[j++] = input[++i];
                    output[j++] = input[++i];
                    count = 0;
                    eligible = 0;
                    prevZero = 0;
                    continue;
                }
                else if (i + 2 < len && input[i + 1] == '1' && input[i + 2] == '1')
                {
                    printf("Error: Invalid bit pattern - 0 followed by 7 consecutive 1's detected. Bit stuffing error!\n");
                    output[j] = '\0';
                    return -1;
                }
                else
                {
                    count = 0;
                    eligible = 0;
                }
            }
            prevZero = 0;
        }
        else /* c == '0' */
        {
            output[j++] = c;
            count = 0;
            eligible = 0;
            prevZero = 1;
        }
    }
    output[j] = '\0';
    return 0;
}
void bitStuffing(char *data, int totalBits, int numFrames)
{
    int bitsPerFrame;
    int i, f;
    char frameData[1000];
    char stuffedInfo[1000];
    PPP_Frame frame;
    FILE *fp;

    if (numFrames <= 0 || totalBits % numFrames != 0)
    {
        printf("Error: Total bits is not divisible by number of frames.\n");
        return;
    }

    bitsPerFrame = totalBits / numFrames;

    fp = fopen(FILENAME, "w");
    if (fp == NULL)
    {
        printf("Error: Could not open file for writing.\n");
        return;
    }

    for (f = 0; f < numFrames; f++)
    {
        for (i = 0; i < bitsPerFrame; i++)
        {
            frameData[i] = data[f * bitsPerFrame + i];
        }
        frameData[bitsPerFrame] = '\0';

        stuffData(frameData, stuffedInfo);

        strcpy(frame.flag1, FLAG);
        strcpy(frame.address, ADDRESS);
        strcpy(frame.control, CONTROL);
        strcpy(frame.information, stuffedInfo);
        strcpy(frame.fcs, FCS);
        strcpy(frame.flag2, FLAG);

        fprintf(fp, "%s%s%s%s%s%s\n",
                frame.flag1, frame.address, frame.control,
                frame.information, frame.fcs, frame.flag2);

        printf("\nData %d:\n", f + 1);
        printf("Original Data : %s\n", frameData);
        printf("Stuffed Data  : %s\n", stuffedInfo);
    }

    fclose(fp);
    printf("\nAll %d frame(s) written successfully to \"%s\".\n", numFrames, FILENAME);
}
int parseFrame(char *line, PPP_Frame *frame)
{
    int len = strlen(line);
    int fixedLen = FLAG_LEN + ADDR_LEN + CTRL_LEN + FCS_LEN + FLAG_LEN;
    int infoLen;
    int i;
    int infoStart, fcsStart, flag2Start;

    if (len < fixedLen)
    {
        return -1;
    }

    for (i = 0; i < FLAG_LEN; i++)
        frame->flag1[i] = line[i];
    frame->flag1[FLAG_LEN] = '\0';

    for (i = 0; i < ADDR_LEN; i++)
        frame->address[i] = line[FLAG_LEN + i];
    frame->address[ADDR_LEN] = '\0';

    for (i = 0; i < CTRL_LEN; i++)
        frame->control[i] = line[FLAG_LEN + ADDR_LEN + i];
    frame->control[CTRL_LEN] = '\0';

    flag2Start = len - FLAG_LEN;
    fcsStart   = flag2Start - FCS_LEN;

    for (i = 0; i < FCS_LEN; i++)
        frame->fcs[i] = line[fcsStart + i];
    frame->fcs[FCS_LEN] = '\0';

    for (i = 0; i < FLAG_LEN; i++)
        frame->flag2[i] = line[flag2Start + i];
    frame->flag2[FLAG_LEN] = '\0';

    infoStart = FLAG_LEN + ADDR_LEN + CTRL_LEN;
    infoLen   = fcsStart - infoStart;

    if (infoLen < 0 || infoLen >= (int)sizeof(frame->information))
    {
        return -1;
    }

    for (i = 0; i < infoLen; i++)
        frame->information[i] = line[infoStart + i];
    frame->information[infoLen] = '\0';

    return 0;
}
void bitDestuffing(void)
{
    FILE *fp;
    char line[2000];
    char combined[MAX_BITS];
    char destuffedInfo[1000];
    PPP_Frame frame;
    int len, frameNo = 1;
    int status;

    combined[0] = '\0';

    fp = fopen(FILENAME, "r");
    if (fp == NULL)
    {
        printf("Error: File \"%s\" not found. Please perform Bit Stuffing first.\n", FILENAME);
        return;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        len = strlen(line);
        if (len > 0 && line[len - 1] == '\n')
        {
            line[len - 1] = '\0';
        }

        if (parseFrame(line, &frame) != 0)
        {
            printf("Error: Malformed frame encountered. Skipping.\n");
            continue;
        }

        printf("\nData %d:\n", frameNo++);
        printf("Stuffed Data  : %s\n", frame.information);

        status = destuffData(frame.information, destuffedInfo);

        if (status == -1)
        {
            printf("Frame rejected due to invalid bit stuffing pattern.\n");
            continue;
        }

        printf("Destuffed Data : %s\n", destuffedInfo);

        strcat(combined, destuffedInfo);
    }

    fclose(fp);

    printf("\nCombined Original Data: %s\n", combined);
}
void displayFrames(void)
{
    FILE *fp;
    char line[2000];
    int len, frameNo = 1;

    fp = fopen(FILENAME, "r");
    if (fp == NULL)
    {
        printf("Error: File \"%s\" not found. Please perform Bit Stuffing first.\n", FILENAME);
        return;
    }

    printf("\n--- Stored Frames in \"%s\" ---\n", FILENAME);

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        len = strlen(line);
        if (len > 0 && line[len - 1] == '\n')
        {
            line[len - 1] = '\0';
        }

        if (strlen(line) == 0)
        {
            continue;
        }

        printf("Frame %d: %s\n", frameNo++, line);
    }

    fclose(fp);

    if (frameNo == 1)
    {
        printf("No frames found in the file.\n");
    }
}

