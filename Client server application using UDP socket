#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <netinet/in.h>
#define MAX_ENTRIES 20
struct Table {
    char ip[20];
    char mac[20];
};
struct Table server_table[MAX_ENTRIES];
int server_count = 0;
void load_database() {
    FILE *file = fopen("database.txt", "r");
    if (file == NULL) {
        perror("Error opening database.txt. Make sure it exists.");
        exit(1);
    }

    while (fscanf(file, "%19s %19s", server_table[server_count].ip, server_table[server_count].mac) == 2) {
        server_count++;
        if (server_count >= MAX_ENTRIES) break;
    }

    fclose(file);
    printf("Successfully loaded %d records from database.txt\n", server_count);
}

int main() {
    load_database();
    int i;
    int server_fd = socket(AF_INET, SOCK_STREAM, 0);
    struct sockaddr_in addr;
    addr.sin_family = AF_INET;
    addr.sin_port = htons(9090);
    addr.sin_addr.s_addr = INADDR_ANY;
    memset(addr.sin_zero, 0, 8);
    int opt = 1;
    setsockopt(server_fd, SOL_SOCKET, SO_REUSEADDR, &opt, sizeof(opt));
    if (bind(server_fd, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
        perror("Bind failed");
        return 1;
    }
    listen(server_fd, 5);
    printf("Server running and waiting for queries...\n\n");
    while (1) {
        int client_fd = accept(server_fd, NULL, NULL);
        if (client_fd < 0) continue;
        char requested_ip[20] = {0};
        recv(client_fd, requested_ip, sizeof(requested_ip) - 1, 0);
        printf("[Server] Received query for IP: %s\n", requested_ip);
        char response_mac[20] = "NOT_FOUND";
        for ( i = 0; i < server_count; i++) {
            if (strcmp(server_table[i].ip, requested_ip) == 0) {
                strcpy(response_mac, server_table[i].mac);
                break;
            }
        }
        send(client_fd, response_mac, strlen(response_mac), 0);
        printf("[Server] Responded with MAC: %s\n\n", response_mac);
        close(client_fd);
    }

    close(server_fd);
    return 0;
}
