#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/socket.h>
#include <arpa/inet.h>
#define CACHE_SIZE 20
#define NOT_FOUND "NOT_FOUND"
struct Table {
    char ip[20];
    char mac[20];
};
struct Table client_table[CACHE_SIZE];
int client_count = 0;
void load_client_database() {
    FILE *file = fopen("client_database.txt", "r");
    if (file == NULL) {
        printf("[INFO] client_database.txt not found. Starting with empty/default cache.\n");
        return;
    }
    while (fscanf(file, "%19s %19s", client_table[client_count].ip, client_table[client_count].mac) == 2) {
        client_count++;
        if (client_count >= CACHE_SIZE) break;
    }
    fclose(file);
    printf("Successfully loaded %d records from client_database.txt\n", client_count);
}
int main() {
    load_client_database();
    char query_ip[20];
    while (1) {
        printf("\nEnter IP Address to search (or 'exit' to quit): ");
        scanf("%19s", query_ip);
        if (strcmp(query_ip, "exit") == 0) break;
        int i;
int found = 0;
        for ( i = 0; i < client_count; i++) {
            if (strcmp(client_table[i].ip, query_ip) == 0) {
                printf("\n[CLIENT CACHE HIT] IP found locally!\n");
                printf("IP: %s ---> MAC: %s\n", client_table[i].ip, client_table[i].mac);
                found = 1;
                break;
            }
        }
        if (!found) {
            printf("\n[CLIENT CACHE MISS] IP not found locally. Querying Server...\n");
            int sock = socket(AF_INET, SOCK_STREAM, 0);
            struct sockaddr_in addr;
            addr.sin_family = AF_INET;
            addr.sin_port = htons(9090);
            addr.sin_addr.s_addr = inet_addr("127.0.0.1");
            memset(addr.sin_zero, 0, 8);
            if (connect(sock, (struct sockaddr*)&addr, sizeof(addr)) < 0) {
                printf("[ERROR] Could not connect to Server.\n");
                close(sock);
                continue;
            }
            send(sock, query_ip, strlen(query_ip), 0);
            char received_mac[20] = {0};
            recv(sock, received_mac, sizeof(received_mac) - 1, 0);
            if (strcmp(received_mac, NOT_FOUND) != 0) {
                printf("[SERVER RESPONSE] Found on Server!\n");
                printf("IP: %s ---> MAC: %s\n", query_ip, received_mac);
                if (client_count < CACHE_SIZE) {
                    strcpy(client_table[client_count].ip, query_ip);
                    strcpy(client_table[client_count].mac, received_mac);
                    client_count++;
                    printf("[CLIENT] Saved new record to local client table memory.\n");
                    FILE *db_file = fopen("client_database.txt", "a");
                    if (db_file != NULL) {
                        fprintf(db_file, "%s %s\n", query_ip, received_mac);
                        fclose(db_file);
                        printf("[CLIENT] Appended new record to client_database.txt.\n");
                    } else {
                        printf("[ERROR] Could not open client_database.txt for appending.\n");
                    }
                }
            } else {
                printf("[SERVER RESPONSE] IP not found on Server either.\n");
            }

            close(sock);
        }
    }

    return 0;
}


