#ifndef HEAD_H
#define HEAD_H

#include <stdio.h>
#include <string.h>
#include <stdlib.h>

#define MAX_BITS    10000
#define MAX_FRAMES  100
#define FILENAME    "bitframe.dat"

#define FLAG    "01111110"
#define ADDRESS "11111111"
#define CONTROL "00000011"

#define POLYNOMIAL "100000111"
#define POLY_LEN   9
#define POLY_DEG   8
#define FLAG_LEN    8
#define ADDR_LEN    8
#define CTRL_LEN    8
#define FCS_LEN     8
#define MAXDEG      1100

typedef struct
{
    char flag1[9];
    char address[9];
    char control[9];
    char information[1000];
    char fcs[9];
    char flag2[9];
} PPP_Frame;

void bitStuffing(char *data, int totalBits, int numFrames);
void bitDestuffing(void);
void displayFrames(void);
int  parseFrame(char *line, PPP_Frame *frame);
void stuffData(char *input, char *output);
int  destuffData(char *input, char *output);
int  degreeOf(int *coeff, int len);
void printPoly(int *coeff, int len);
void polynomialModSubtract(int *a, int *b, int *result, int len);
void polynomialLongDivision(int *dividend, int dividendLen,
                             int *divisor, int divisorLen,
                             int *quotientOut, int *remainderOut,
                             int verbose);
void bitsToCoeff(const char *bits, int *coeff, int len);
void coeffToBits(int *coeff, int len, char *bits);
void computeCRC(const char *bits, int len, char *remainderOut);
void crcDivide(const char *bits, int totalLen, char *remainderOut);
int  isAllZero(char *bits);
#endif

#include "crc.h"
int degreeOf(int *coeff, int len)
{
    int i;
    for (i = 0; i < len; i++)
    {
        if (coeff[i] == 1)
        {
            return len - 1 - i;
        }
    }
    return -1;   /* zero polynomial */
}
void printPoly(int *coeff, int len)
{
    int i, deg, first = 1;
    for (i = 0; i < len; i++)
    {
        if (coeff[i] == 1)
        {
            deg = len - 1 - i;
            if (!first) printf(" + ");
            first = 0;
            if (deg == 0)      printf("1");
            else if (deg == 1) printf("x");
            else               printf("x^%d", deg);
        }
    }
    if (first) printf("0");
}
void polynomialModSubtract(int *a, int *b, int *result, int len)
{
    int i;
    for (i = 0; i < len; i++)
    {
        result[i] = (a[i] - b[i] + 2) % 2;
    }
}
void polynomialLongDivision(int *dividend, int dividendLen,
                             int *divisor, int divisorLen,
                             int *quotientOut, int *remainderOut,
                             int verbose)
{
    int remainder[MAXDEG];
    int shiftedDivisor[MAXDEG];
    int subtractResult[MAXDEG];
    int i, divisorDeg, remDeg, shift;
    int quotientLen = dividendLen - divisorLen + 1;

    for (i = 0; i < dividendLen; i++) remainder[i] = dividend[i];
    for (i = 0; i < quotientLen; i++) quotientOut[i] = 0;

    divisorDeg = degreeOf(divisor, divisorLen);

    if (verbose)
    {
        printf("Dividend polynomial : ");
        printPoly(dividend, dividendLen);
        printf("\nDivisor polynomial  : ");
        printPoly(divisor, divisorLen);
        printf("  (degree %d)\n\n", divisorDeg);
    }

    while (1)
    {
        remDeg = degreeOf(remainder, dividendLen);

        if (remDeg < divisorDeg || remDeg == -1)
        {
            break;   /* division complete */
        }

        shift = remDeg - divisorDeg;

        if (verbose)
        {
            printf("Quotient term: x^%d  (remainder leading term x^%d, divisor leading term x^%d)\n",
                   shift, remDeg, divisorDeg);
        }

        quotientOut[quotientLen - 1 - shift] = 1;

        for (i = 0; i < dividendLen; i++) shiftedDivisor[i] = 0;
        for (i = 0; i < divisorLen; i++)
        {
            shiftedDivisor[(dividendLen - 1) - (shift + (divisorLen - 1 - i))] = divisor[i];
        }

        if (verbose)
        {
            printf("   Remainder so far    : ");
            printPoly(remainder, dividendLen);
            printf("\n   Subtract (G(x)*x^%d) : ", shift);
            printPoly(shiftedDivisor, dividendLen);
        }

        polynomialModSubtract(remainder, shiftedDivisor, subtractResult, dividendLen);
        for (i = 0; i < dividendLen; i++) remainder[i] = subtractResult[i];

        if (verbose)
        {
            printf("\n   New remainder       : ");
            printPoly(remainder, dividendLen);
            printf("\n\n");
        }
    }

    for (i = 0; i < dividendLen; i++) remainderOut[i] = remainder[i];

    if (verbose)
    {
        printf("QUOTIENT  : ");
        printPoly(quotientOut, quotientLen);
        printf("\nREMAINDER : ");
        printPoly(remainderOut, dividendLen);
        printf("\n");
    }
}
void bitsToCoeff(const char *bits, int *coeff, int len)
{
    int i;
    for (i = 0; i < len; i++) coeff[i] = bits[i] - '0';
}
void coeffToBits(int *coeff, int len, char *bits)
{
    int i;
    for (i = 0; i < len; i++) bits[i] = (char)(coeff[i] + '0');
    bits[len] = '\0';
}
void computeCRC(const char *bits, int len, char *remainderOut)
{
    char dividendBits[MAXDEG];
    int dividend[MAXDEG], divisor[POLY_LEN];
    int quotient[MAXDEG], remainder[MAXDEG];
    int dividendLen;

    strcpy(dividendBits, bits);
    strcat(dividendBits, "00000000");
    dividendLen = (int)strlen(dividendBits);

    bitsToCoeff(dividendBits, dividend, dividendLen);
    bitsToCoeff(POLYNOMIAL, divisor, POLY_LEN);

    printf("\n--- crcSender(): Polynomial Long Division ---\n");
    polynomialLongDivision(dividend, dividendLen, divisor, POLY_LEN, quotient, remainder, 1);

    coeffToBits(&remainder[dividendLen - POLY_DEG], POLY_DEG, remainderOut);
}
void crcDivide(const char *bits, int totalLen, char *remainderOut)
{
    int dividend[MAXDEG], divisor[POLY_LEN];
    int quotient[MAXDEG], remainder[MAXDEG];

    bitsToCoeff(bits, dividend, totalLen);
    bitsToCoeff(POLYNOMIAL, divisor, POLY_LEN);

    printf("\n--- crcReceiver(): Polynomial Long Division ---\n");
    polynomialLongDivision(dividend, totalLen, divisor, POLY_LEN, quotient, remainder, 1);

    
    coeffToBits(&remainder[totalLen - POLY_DEG], POLY_DEG, remainderOut);
}
int isAllZero(char *bits)
{
    int i;
    int len = strlen(bits);

    for (i = 0; i < len; i++)
    {
        if (bits[i] != '0')
        {
            return 0;
        }
    }
    return 1;
}
void stuffData(char *input, char *output)
{
    int i, j = 0, count = 0;
    int len = strlen(input);
    int prevZero = 0;
    int eligible = 0;

    for (i = 0; i < len; i++)
    {
        char c = input[i];

        if (c == '1')
        {
            if (count == 0)
            {
                eligible = prevZero;
            }
            output[j++] = c;
            count++;

            if (count == 5 && eligible)
            {
                output[j++] = '0';
                count = 0;
                eligible = 0;
            }
            prevZero = 0;
        }
        else
        {
            output[j++] = c;
            count = 0;
            eligible = 0;
            prevZero = 1;
        }
    }
    output[j] = '\0';
}

int destuffData(char *input, char *output)
{
    int i, j = 0, count = 0;
    int len = strlen(input);
    int prevZero = 0;
    int eligible = 0;

    for (i = 0; i < len; i++)
    {
        char c = input[i];

        if (c == '1')
        {
            if (count == 0)
            {
                eligible = prevZero;
            }
            output[j++] = c;
            count++;

            if (count == 5 && eligible)
            {
                if (i + 1 < len && input[i + 1] == '0')
                {
                    i++;
                    count = 0;
                    eligible = 0;
                    prevZero = 0;
                    continue;
                }
                else if (i + 2 < len && input[i + 1] == '1' && input[i + 2] == '0')
                {
                    printf("Warning: Flag pattern (01111110) detected inside the field.\n");
                    output[j++] = input[++i];
                    output[j++] = input[++i];
                    count = 0;
                    eligible = 0;
                    prevZero = 0;
                    continue;
                }
                else if (i + 2 < len && input[i + 1] == '1' && input[i + 2] == '1')
                {
                    printf("Error: Invalid bit pattern - 0 followed by 7 consecutive 1's detected. Bit stuffing error!\n");
                    output[j] = '\0';
                    return -1;
                }
                else
                {
                    count = 0;
                    eligible = 0;
                }
            }
            prevZero = 0;
        }
        else
        {
            output[j++] = c;
            count = 0;
            eligible = 0;
            prevZero = 1;
        }
    }
    output[j] = '\0';
    return 0;
}
void bitStuffing(char *data, int totalBits, int numFrames)
{
    int bitsPerFrame;
    int i, f;
    char frameData[1000];
    char stuffedInfo[1000];
    char crcMessage[1100];
    char fcsRemainder[9];
    PPP_Frame frame;
    FILE *fp;

    if (numFrames <= 0 || totalBits % numFrames != 0)
    {
        printf("Error: Total bits is not divisible by number of frames.\n");
        return;
    }

    bitsPerFrame = totalBits / numFrames;

    fp = fopen(FILENAME, "w");
    if (fp == NULL)
    {
        printf("Error: Could not open file for writing.\n");
        return;
    }

    for (f = 0; f < numFrames; f++)
    {
        for (i = 0; i < bitsPerFrame; i++)
        {
            frameData[i] = data[f * bitsPerFrame + i];
        }
        frameData[bitsPerFrame] = '\0';

        stuffData(frameData, stuffedInfo);

        strcpy(crcMessage, ADDRESS);
        strcat(crcMessage, CONTROL);
        strcat(crcMessage, stuffedInfo);

        printf("\nFrame %d:\n", f + 1);
        printf("Original Data : %s\n", frameData);
        printf("Stuffed Data  : %s\n", stuffedInfo);

        computeCRC(crcMessage, (int)strlen(crcMessage), fcsRemainder);
        printf("==> CRC-8 (FCS) = %s\n", fcsRemainder);

        strcpy(frame.flag1, FLAG);
        strcpy(frame.address, ADDRESS);
        strcpy(frame.control, CONTROL);
        strcpy(frame.information, stuffedInfo);
        strcpy(frame.fcs, fcsRemainder);
        strcpy(frame.flag2, FLAG);

        fprintf(fp, "%s%s%s%s%s%s\n",
                frame.flag1, frame.address, frame.control,
                frame.information, frame.fcs, frame.flag2);
    }

    fclose(fp);
    printf("\nAll %d frame(s) written successfully to \"%s\".\n", numFrames, FILENAME);
}
int parseFrame(char *line, PPP_Frame *frame)
{
    int len = strlen(line);
    int fixedLen = FLAG_LEN + ADDR_LEN + CTRL_LEN + FCS_LEN + FLAG_LEN;
    int infoLen;
    int i;
    int infoStart, fcsStart, flag2Start;

    if (len < fixedLen)
    {
        return -1;
    }

    for (i = 0; i < FLAG_LEN; i++)
        frame->flag1[i] = line[i];
    frame->flag1[FLAG_LEN] = '\0';

    for (i = 0; i < ADDR_LEN; i++)
        frame->address[i] = line[FLAG_LEN + i];
    frame->address[ADDR_LEN] = '\0';

    for (i = 0; i < CTRL_LEN; i++)
        frame->control[i] = line[FLAG_LEN + ADDR_LEN + i];
    frame->control[CTRL_LEN] = '\0';

    flag2Start = len - FLAG_LEN;
    fcsStart   = flag2Start - FCS_LEN;

    for (i = 0; i < FCS_LEN; i++)
        frame->fcs[i] = line[fcsStart + i];
    frame->fcs[FCS_LEN] = '\0';

    for (i = 0; i < FLAG_LEN; i++)
        frame->flag2[i] = line[flag2Start + i];
    frame->flag2[FLAG_LEN] = '\0';

    infoStart = FLAG_LEN + ADDR_LEN + CTRL_LEN;
    infoLen   = fcsStart - infoStart;

    if (infoLen < 0 || infoLen >= (int)sizeof(frame->information))
    {
        return -1;
    }

    for (i = 0; i < infoLen; i++)
        frame->information[i] = line[infoStart + i];
    frame->information[infoLen] = '\0';

    return 0;
}
void bitDestuffing(void)
{
    FILE *fp;
    char line[2000];
    char combined[MAX_BITS];
    char destuffedInfo[1000];
    char crcCheckMessage[1100];
    char remainder[9];
    PPP_Frame frame;
    int len, frameNo = 1;
    int status;

    combined[0] = '\0';

    fp = fopen(FILENAME, "r");
    if (fp == NULL)
    {
        printf("Error: File \"%s\" not found. Please perform Bit Stuffing first.\n", FILENAME);
        return;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        len = strlen(line);
        if (len > 0 && line[len - 1] == '\n')
        {
            line[len - 1] = '\0';
        }

        if (parseFrame(line, &frame) != 0)
        {
            printf("Error: Malformed frame encountered. Skipping.\n");
            continue;
        }

        printf("\nFrame %d:\n", frameNo++);
        printf("Received Address       : %s\n", frame.address);
        printf("Received Control       : %s\n", frame.control);
        printf("Received Information   : %s\n", frame.information);
        printf("Received FCS (CRC-8)   : %s\n", frame.fcs);

        strcpy(crcCheckMessage, frame.address);
        strcat(crcCheckMessage, frame.control);
        strcat(crcCheckMessage, frame.information);
        strcat(crcCheckMessage, frame.fcs);

        crcDivide(crcCheckMessage, (int)strlen(crcCheckMessage), remainder);
        printf("==> CRC Remainder = %s\n", remainder);

        if (isAllZero(remainder))
        {
            printf("Result                  : No Error Detected\n");
        }
        else
        {
            printf("Result                  : Error Detected\n");
            continue;
        }

        status = destuffData(frame.information, destuffedInfo);

        if (status == -1)
        {
            printf("Frame rejected due to invalid bit stuffing pattern.\n");
            continue;
        }

        printf("Destuffed Information   : %s\n", destuffedInfo);

        strcat(combined, destuffedInfo);
    }

    fclose(fp);

    printf("\nCombined Original Data: %s\n", combined);
}
void displayFrames(void)
{
    FILE *fp;
    char line[2000];
    int len, frameNo = 1;

    fp = fopen(FILENAME, "r");
    if (fp == NULL)
    {
        printf("Error: File \"%s\" not found. Please perform Bit Stuffing first.\n", FILENAME);
        return;
    }

    printf("\n--- Stored Frames in \"%s\" ---\n", FILENAME);

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        len = strlen(line);
        if (len > 0 && line[len - 1] == '\n')
        {
            line[len - 1] = '\0';
        }

        if (strlen(line) == 0)
        {
            continue;
        }

        printf("Frame %d: %s\n", frameNo++, line);
    }

    fclose(fp);

    if (frameNo == 1)
    {
        printf("No frames found in the file.\n");
    }
}


#include "crc.h"

int main(void)
{
    int choice;
    int totalBits, numFrames;
    char data[MAX_BITS];

    while (1)
    {
        printf("\n===== HDLC Bit Stuffing / Bit Destuffing (CRC-8 Polynomial Division) =====\n");
        printf("1. Bit Stuffing\n");
        printf("2. Bit Destuffing\n");
        printf("3. Display Frames\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1)
        {
            while (getchar() != '\n')
                ;
            printf("Invalid input. Please enter a number.\n");
            continue;
        }

        switch (choice)
        {
        case 1:
            printf("Enter Total Number of Bits: ");
            scanf("%d", &totalBits);

            printf("Enter Number of Frames: ");
            scanf("%d", &numFrames);

            if (numFrames <= 0 || totalBits <= 0 || totalBits % numFrames != 0)
            {
                printf("Error: Total bits is not divisible by number of frames.\n");
                break;
            }

            if (totalBits >= MAX_BITS)
            {
                printf("Error: Total bits exceeds maximum supported size.\n");
                break;
            }

            printf("Enter Binary Data (%d bits, no spaces): ", totalBits);
            scanf("%s", data);

            if ((int)strlen(data) != totalBits)
            {
                printf("Error: Entered data length does not match total bits.\n");
                break;
            }

            bitStuffing(data, totalBits, numFrames);
            break;

        case 2:
            bitDestuffing();
            break;

        case 3:
            displayFrames();
            break;

        case 4:
            printf("Exiting program. Goodbye!\n");
            exit(0);

        default:
            printf("Invalid choice. Please select 1, 2, 3, or 4.\n");
        }
    }

    return 0;
}
